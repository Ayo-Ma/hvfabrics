# Copy to .env.local. These are public client settings (they ship in the app), not secrets.
VITE_API_URL=http://localhost:8787
# Leave the Firebase values empty for local development: the sign-in screen then offers
# dev roles, which the API accepts only while it serves placeholder data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase console → Project settings → Cloud Messaging).
VITE_FCM_VAPID_KEY=
