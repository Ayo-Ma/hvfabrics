{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hv-storefront",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    // "development" serves the placeholder seed catalogue; "production" refuses to.
    "ENVIRONMENT": "development",
    // Base URL of the API Worker (catalogue, checkout). Empty = not connected yet.
    "API_URL": "https://hv-api.harriesvogueglobal.workers.dev",
    // Public R2 domain for product images. Empty = placeholders only.
    // Photos come through the shop's own address (workers/app.ts), so phones skip a second connection.
        "IMAGE_BASE": "/images"
  },
  // Production: build and deploy with CLOUDFLARE_ENV=production (docs/SETUP.md).
  "env": {
    "production": {
      "name": "hv-storefront",
      // Direct line to the API Worker (Worker-to-Worker over workers.dev is blocked by Cloudflare).
      "services": [{ "binding": "API", "service": "hv-api" }],
      "vars": {
        "ENVIRONMENT": "production",
        "API_URL": "https://hv-api.harriesvogueglobal.workers.dev",
        // Photos come through the shop's own address (workers/app.ts), so phones skip a second connection.
        "IMAGE_BASE": "/images"
      }
    }
  }
}
