{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hv-storefront",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    // "development" serves the placeholder seed catalogue; "production" refuses to.
    "ENVIRONMENT": "development",
    // Base URL of the API Worker (catalogue, checkout). Empty = not connected yet.
    "API_URL": "https://hv-api.harriesvogueglobal.workers.dev",
    // Public R2 domain for product images. Empty = placeholders only.
    "IMAGE_BASE": "https://hv-api.harriesvogueglobal.workers.dev/images"
  },
  // Production: build and deploy with CLOUDFLARE_ENV=production (docs/SETUP.md).
  "env": {
    "production": {
      "name": "hv-storefront",
      "vars": {
        "ENVIRONMENT": "production",
        "API_URL": "REPLACE_WITH_API_URL",
        "IMAGE_BASE": "REPLACE_WITH_API_URL/images"
      }
    }
  }
}
