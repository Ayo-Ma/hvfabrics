{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hv-api",
	"main": "./src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Release expired stock holds and cancel unpaid orders (PLAN.md checkout step 6).
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"vars": {
		// "development" with no Firebase secrets = in-memory store seeded with placeholder products.
		"ENVIRONMENT": "development",
		// Only this origin may receive Paystack's redirect back (prevents open redirects).
		"STOREFRONT_ORIGIN": "http://localhost:5173",
		// The dashboard PWA; the only origin allowed to call /admin/*.
		"DASHBOARD_ORIGIN": "http://localhost:5180",
		// Sender for transactional email (Resend). Must be a verified domain before launch.
		"EMAIL_FROM": "Harries Vogue <orders@example.com>",
		// "card" = Paystack; "transfer" = customers pay into the shop's account (settings/store.bankTransfer) and she confirms it.
		"PAYMENT_MODE": "card"
	},
	// Built catalogue JSON, read by the storefront. Create with: wrangler kv namespace create CATALOGUE
	// Product photos, uploaded from the dashboard. Create with: wrangler r2 bucket create hv-images
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "hv-images"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CATALOGUE",
			"id": "231ac665ff404338a796ede6768ad2be",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "CHECKOUT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "SEARCH_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "EVENTS",
			"dataset": "hv_events"
		}
	],
	// Production: deploy with `corepack pnpm exec wrangler deploy --env production` (docs/SETUP.md).
	// Bindings aren't inherited by environments, so they are repeated here.
	"env": {
		// End-to-end tests (qa/): in-memory store + local Paystack stand-in. Secrets come from .dev.vars.e2e (fake keys only).
		"e2e": {
			"name": "hv-api-e2e",
			"vars": {
				"ENVIRONMENT": "development",
				"STOREFRONT_ORIGIN": "http://localhost:5173",
				"DASHBOARD_ORIGIN": "http://localhost:5180",
				"EMAIL_FROM": "Harries Vogue <onboarding@resend.dev>",
				"PAYMENT_MODE": "card"
			},
			"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "hv-images" }],
			"kv_namespaces": [{ "binding": "CATALOGUE", "id": "e2e-local" }],
			"ratelimits": [
				{ "name": "CHECKOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } },
				{ "name": "SEARCH_LIMITER", "namespace_id": "1002", "simple": { "limit": 1000, "period": 60 } }
			]
		},
		"production": {
			"name": "hv-api",
			"vars": {
				"ENVIRONMENT": "production",
				"STOREFRONT_ORIGIN": "https://hv-storefront.harriesvogueglobal.workers.dev",
				"DASHBOARD_ORIGIN": "https://hv-dashboard.harriesvogueglobal.workers.dev",
				"EMAIL_FROM": "Harries Vogue <onboarding@resend.dev>",
				// Bank transfer until Paystack is verified (2026-11-20). Switch to "card" once the live keys are in.
				"PAYMENT_MODE": "transfer"
			},
			// Product photos, uploaded from the dashboard.
			"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "hv-images" }],
			"kv_namespaces": [
				{
					"binding": "CATALOGUE",
					"id": "231ac665ff404338a796ede6768ad2be"
				}
			],
			"ratelimits": [
				{
					"name": "CHECKOUT_LIMITER",
					"namespace_id": "1001",
					"simple": {
						"limit": 10,
						"period": 60
					}
				},
				{
					"name": "SEARCH_LIMITER",
					"namespace_id": "1002",
					"simple": {
						"limit": 120,
						"period": 60
					}
				}
			],
			// Visit statistics are off until Analytics Engine is enabled (Cloudflare → Workers & Pages → Analytics Engine).
			// "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "hv_events" }]
		}
	}
}