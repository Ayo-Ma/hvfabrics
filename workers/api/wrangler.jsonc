{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hv-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Release expired stock holds and cancel unpaid orders (PLAN.md checkout step 6).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // "development" with no Firebase secrets = in-memory store seeded with placeholder products.
    "ENVIRONMENT": "development",
    // Only this origin may receive Paystack's redirect back (prevents open redirects).
    "STOREFRONT_ORIGIN": "http://localhost:5173",
    // Sender for transactional email (Resend). Must be a verified domain before launch.
    "EMAIL_FROM": "Harries Vogue <orders@example.com>"
  },
  // Built catalogue JSON, read by the storefront. Create with: wrangler kv namespace create CATALOGUE
  "kv_namespaces": [{ "binding": "CATALOGUE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "ratelimits": [
    { "name": "CHECKOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "hv_events" }]
}
